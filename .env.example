# Copy to `.env.local` and set values. `.env.local` is gitignored.

# Production base URL for canonical links, sitemap, Open Graph, JSON-LD.
# In development you can omit this or use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Beehiiv — required for POST /api/subscribe (newsletter form)
NEWSLETTER_API_KEY=
NEWSLETTER_PUBLICATION_ID=
